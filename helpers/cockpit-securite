def ports_of(inst):
    code, out = in_inst(inst, ["ss", "-H", "-ltunp"], timeout=10)
    if code != 0:
        code, out = in_inst(inst, ["netstat", "-ltunp"], timeout=10)
        rows = []
        for l in out.splitlines():
            p = l.split()
            if len(p) >= 6 and p[0] in ("tcp", "udp", "tcp6", "udp6"):
                prog = p[-1].split("/", 1)[-1] if "/" in p[-1] else ""
                rows.append({"proto": p[0], "addr": p[3], "proc": prog})
        return rows
    rows = []
    for l in out.splitlines():
        p = l.split()
        if len(p) < 5:
            continue
        proc = re.findall(r'\("([^"]+)"', l)
        rows.append({"proto": p[0], "addr": p[4], "proc": ",".join(sorted(set(proc)))})
    uniq = {(r["proto"], r["addr"]): r for r in rows}
    return sorted(uniq.values(), key=lambda r: (r["proto"], r["addr"]))


UPD_CACHE = "/var/cache/cockpit-securite"
UPD_TTL = 3600  # s : la recherche de MAJ (apt/apk dans chaque container) coûte ~20 s de CPU → 1 h de cache


def updates_of(inst):
    """Résultat mis en cache 1 h par instance (fichier root 600) : évite de relancer apt/apk partout
    à chaque ouverture du module Sécurité ou du tableau de bord."""
    cf = os.path.join(UPD_CACHE, "updates-%s.json" % re.sub(r"[^A-Za-z0-9_.-]", "_", str(inst)))
    try:
        if time.time() - os.path.getmtime(cf) < UPD_TTL:
            with open(cf) as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    res = _updates_of(inst)
    try:
        os.makedirs(UPD_CACHE, mode=0o700, exist_ok=True)
        tmp = cf + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(res, f)
        os.replace(tmp, cf)
    except OSError:
        pass
    return res


def _updates_of(inst):
    base = rootfs(inst)
    if os.path.exists(os.path.join(base, "usr/bin/apt")):
        code, out = in_inst(inst, ["apt", "list", "--upgradable"], timeout=40)
        pk = [l.split("/")[0] for l in out.splitlines() if "/" in l and "upgradable" in l]
        sec = [l.split("/")[0] for l in out.splitlines() if "-security" in l]
        stamp = os.path.join(base, "var/lib/apt/periodic/update-success-stamp")
        return {"mgr": "apt", "n": len(pk), "security": sec, "pkgs": pk[:200],
                "reboot": os.path.exists(os.path.join(base, "var/run/reboot-required")) or
                          os.path.exists(os.path.join(base, "run/reboot-required")),
                "refreshed": datetime.fromtimestamp(os.path.getmtime(stamp), timezone.utc).isoformat()
                             if os.path.exists(stamp) else None}
    if os.path.exists(os.path.join(base, "sbin/apk")):
        code, out = in_inst(inst, ["apk", "list", "-u"], timeout=40)
        pk = [l.split()[0] for l in out.splitlines() if "upgradable" in l]
        return {"mgr": "apk", "n": len(pk), "security": [], "pkgs": pk[:200], "reboot": False, "refreshed": None}
    return None


def logins():
    code, out = run(["journalctl", "--since", "-14d", "--no-pager", "-q", "-o", "short-iso",
                     "-g", "Accepted (publickey|password)|session opened for user .*cockpit|pam_unix\\(cockpit:auth\\): authentication failure"],
                    timeout=25)
    rows = []
    for l in out.splitlines():
        t = l.split(" ", 1)[0]
        m = re.search(r"Accepted (\w+) for (\S+) from (\S+)", l)
        if m:
            rows.append({"t": t, "kind": "SSH (%s)" % m.group(1), "user": m.group(2), "from": m.group(3), "ok": True})
            continue
        m = re.search(r"pam_unix\(cockpit:session\): session opened for user (\S+?)\(", l)
        if m:
            rows.append({"t": t, "kind": "Cockpit", "user": m.group(1), "from": "via proxy", "ok": True})
            continue
        m = re.search(r"cockpit:auth\): authentication failure.*?(?:rhost=(\S*))?.*?user=(\S+)", l)
        if m:
            rows.append({"t": t, "kind": "Cockpit", "user": m.group(2), "from": m.group(1) or "via proxy", "ok": False})
    return rows[-60:][::-1]


def geoblock():
    code, out = run(["journalctl", "-k", "--since", "-24h", "--no-pager", "-q", "-g", "SSH-GEOBLOCK"], timeout=25)
    ips = Counter(re.findall(r"SRC=(\S+)", out))
    sets = {}
    for name in IPSETS:
        c, o = run(["ipset", "list", name, "-t"], timeout=5)
        m = re.search(r"Number of entries: (\d+)", o)
        sets[name] = int(m.group(1)) if m else None
    return {"blocked_24h": sum(ips.values()), "distinct": len(ips),
            "top": [{"ip": ip, "n": n} for ip, n in ips.most_common(10)], "ipsets": sets}


def backups():
    res = {"dirs": []}
    for sub in ("sql", "www"):
        d = os.path.join(BACKUP_DIR, sub)
        if not os.path.isdir(d):
            continue
        files = [f for f in glob.glob(os.path.join(d, "*")) if os.path.isfile(f) and not f.endswith(".sha256")]
        files.sort(key=os.path.getmtime)
        res["dirs"].append({"name": sub, "count": len(files), "size": sum(os.path.getsize(f) for f in files),
                            "last": [{"f": os.path.basename(f), "size": os.path.getsize(f),
                                      "t": datetime.fromtimestamp(os.path.getmtime(f), timezone.utc).isoformat()}
                                     for f in files[-4:]][::-1]})
    code, out = run(["df", "-B1", "--output=size,used,avail,target", "/"], timeout=5)
    p = out.splitlines()[-1].split() if out else []
    if len(p) >= 3:
        res["disk"] = {"size": int(p[0]), "used": int(p[1]), "avail": int(p[2])}
    return res


def cmd_system(args):
    want = set(args) or {"ports", "updates", "logins", "geoblock", "backups"}
    res = {}
    insts = running_instances()
    if "ports" in want:
        res["ports"] = pmap(lambda i: {"instance": i, "ports": ports_of(i)}, insts)
    if "updates" in want:
        res["updates"] = pmap(lambda i: dict(instance=i, **(updates_of(i) or {"mgr": None, "n": 0})), insts)
    if "logins" in want:
        res["logins"] = logins()
    if "geoblock" in want:
        res["geoblock"] = geoblock()
    if "backups" in want:
        res["backups"] = backups()
    return res


COMMANDS = {"jails": cmd_jails, "history": cmd_history, "ip": cmd_ip, "tasks": cmd_tasks,
            "certs": cmd_certs, "system": cmd_system,
            "ban": lambda a: cmd_ban(a, False), "unban": lambda a: cmd_ban(a, True), "run": cmd_run}
SYSTEM_PARTS = {"ports", "updates", "logins", "geoblock", "backups"}


# Cache court des lectures : ouvrir/rechanger d'onglet ou le tableau de bord ne relance pas
# des dizaines de lxc-attach. « --fresh » (bouton Actualiser) l'ignore ; ban/unban/run le vident.
QUERY_TTL = {"jails": 20, "history": 30, "tasks": 30, "certs": 300, "system": 60}
ACTIONS = {"ban", "unban", "run"}


def _qcache_path(argv):
    key = hashlib.sha1("\0".join(argv).encode()).hexdigest()[:20]
    return os.path.join(UPD_CACHE, "q-%s.json" % key)


def _qcache_clear():
    for f in glob.glob(os.path.join(UPD_CACHE, "q-*.json")):
        try:
            os.remove(f)
        except OSError:
            pass


def main():
    fresh = len(sys.argv) > 1 and sys.argv[1] == "--fresh"
    if fresh:
        del sys.argv[1]
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        fail("sous-commande inconnue (attendu : %s)" % ", ".join(COMMANDS))
    args = sys.argv[2:]
    if sys.argv[1] == "system" and not set(args) <= SYSTEM_PARTS:
        fail("partie inconnue")
    if os.geteuid() != 0:
        fail("l'assistant doit être lancé en root (via sudo)")
    ttl = QUERY_TTL.get(sys.argv[1])
    cf = _qcache_path(sys.argv[1:]) if ttl else None
    if cf and not fresh:
        try:
            st = os.stat(cf)
            if time.time() - st.st_mtime < ttl and st.st_uid == 0:
                with open(cf, encoding="utf-8") as fh:
                    sys.stdout.write(fh.read())
                return
        except OSError:
            pass
    try:
        res = COMMANDS[sys.argv[1]](args)
    except OSError as e:
        fail("erreur : %s" % (e.strerror or e))
    out = json.dumps(res, ensure_ascii=False, separators=(",", ":"))
    if sys.argv[1] in ACTIONS:
        _qcache_clear()
    elif cf:
        try:
            os.makedirs(UPD_CACHE, mode=0o700, exist_ok=True)
            tmp = cf + ".%d" % os.getpid()
            with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as fh:
                fh.write(out)
            os.replace(tmp, cf)
        except OSError:
            pass
    sys.stdout.write(out)


if __name__ == "__main__":
    main()
